generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                     String                  @id @default(uuid())
  username               String                  @unique
  password               String
  name                   String
  role                   String                  @default("PARTNER")
  status                 String                  @default("PENDING")
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  country                String?
  orders                 Order[]
  proformaInvoices       ProformaInvoice[]
  partnerProfile         PartnerProfile?
  inventoryPreference    InventoryPreference?
  inventoryInbounds      InventoryInbound[]
  pushTokens             PushToken[]
  mobileMessages         MobileMessage[]
  mobileOutgoingMessages MobileOutgoingMessage[]
  productStockHistories  ProductStockHistory[]
}

model InventoryPreference {
  id                String   @id @default(uuid())
  userId            String   @unique
  favoriteMasterIds Json     @default("[]")
  masterOrder       Json     @default("[]")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model InventoryInbound {
  id              String                  @id @default(uuid())
  inboundDate     DateTime
  warehouseItemId String?
  masterId        Int?
  productName     String
  productImageUrl String?
  quantity        Int
  createdById     String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  createdBy       User?                   @relation(fields: [createdById], references: [id], onDelete: SetNull)
  warehouseItem   WarehouseInventoryItem? @relation(fields: [warehouseItemId], references: [id], onDelete: SetNull)

  @@index([inboundDate])
  @@index([warehouseItemId])
  @@index([masterId])
  @@index([createdById])
}

model WarehouseInventoryItem {
  id          String             @id @default(uuid())
  name        String
  nameJP      String?
  productCode String?            @unique
  imageUrl    String?
  stock       Int                @default(0)
  sortOrder   Int                @default(0)
  active      Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  inbounds    InventoryInbound[]

  @@index([active])
  @@index([sortOrder])
}

model PushToken {
  id         String   @id @default(uuid())
  userId     String
  token      String   @unique
  platform   String
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  lastSeenAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([enabled])
}

model PartnerProfile {
  id                      String  @id @default(uuid())
  userId                  String  @unique
  contact                 String?
  fax                     String?
  email                   String?
  businessName            String?
  representativeName      String?
  businessRegNumber       String?
  address                 String?
  businessRegistrationUrl String?
  grade                   String  @default("C")
  user                    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Product {
  id                   String                @id @default(uuid())
  productNumber        Int                   @unique @default(autoincrement())
  name                 String
  nameJP               String?
  buyPrice             Float
  cnyBuyPrice          Float?                @default(0)
  usdPurchasePrice     Float?                @default(0)
  purchaseCurrency     String                @default("CNY")
  sellPrice            Float
  onlinePrice          Float?                @default(0)
  priceA               Float?
  priceB               Float?
  priceC               Float?
  priceD               Float?
  stock                Int                   @default(0)
  safetyStock          Int                   @default(0)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  barcode              String?
  productCode          String?
  groupName            String?
  autoGroupingDisabled Boolean               @default(false)
  hsCode               String?
  japanHsCode          String?
  coupangSku           String?               @unique
  imageUrl             String?
  sortOrder            Int                   @default(0)
  minOrderQuantity     Int                   @default(1)
  orderUnit            Int                   @default(1)
  nameEN               String?
  jpBuyPrice           Float?                @default(0)
  jpSellPrice          Float?                @default(0)
  krBuyPrice           Float?                @default(0)
  krSellPrice          Float?                @default(0)
  usBuyPrice           Float?                @default(0)
  usSellPrice          Float?                @default(0)
  regionalPrices       Json?                 @default("{}")
  wholesaleAvailable   Boolean               @default(true)
  orderItems           OrderItem[]
  proformaInvoiceItems ProformaInvoiceItem[]
  stockHistory         ProductStockHistory[]
}

model ProductStockHistory {
  id            String   @id @default(uuid())
  productId     String
  previousStock Int
  newStock      Int
  delta         Int
  source        String
  note          String?
  changedById   String?
  createdAt     DateTime @default(now())
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  changedBy     User?    @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
  @@index([changedById])
}

model Order {
  id                      String       @id @default(uuid())
  userId                  String
  total                   Float
  createdAt               DateTime     @default(now())
  status                  String       @default("PENDING")
  trackingNumber          String?
  courier                 String?
  taxInvoiceIssued        Boolean      @default(false)
  orderNumber             String?      @unique
  depositConfirmedAt      DateTime?
  adminDepositConfirmedAt DateTime?
  user                    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  items                   OrderItem[]
  depositSmsMessages      DepositSms[]
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  productId String
  quantity  Int
  price     Float
  order     Order   @relation(fields: [orderId], references: [id])
  product   Product @relation(fields: [productId], references: [id])
}

model ProductionBatch {
  id              String   @id @default(uuid())
  category        String
  productionDate  DateTime
  rawMaterialCost Int
  depositDollar   Float?
  electricityCost Int
  packagingCost   Int
  warehouseCost   Int      @default(0)
  shippingCost    Int      @default(0)
  customsFee      Int      @default(0)
  customsDuty     Int      @default(0)
  vat             Int      @default(0)
  quantity        Int
  unitCost        Float?
  salesPrice      Int
  wholesalePrice  Int
  memo            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model MaterialSupply {
  id              String    @id @default(uuid())
  name            String
  category        String    @default("")
  supplierName    String    @default("")
  purchaseUrl     String
  unit            String    @default("")
  priceKrw        Int?
  widthValue      Float?
  depthValue      Float?
  heightValue     Float?
  dimensionUnit   String    @default("mm")
  memo            String    @default("")
  active          Boolean   @default(true)
  sortOrder       Int       @default(0)
  lastPurchasedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([active])
  @@index([category])
  @@index([updatedAt])
}

model ElectricityUsage {
  id                   String    @id @default(uuid())
  year                 Int
  month                Int
  readingDate          String
  usagePeriod          String
  meterCurrent         String
  meterPrevious        String
  totalUsage           Int
  totalAmount          Int
  rawBillData          String
  landlordMeterPrev    Int?
  landlordMeterCurr    Int?
  landlordUsage        Int?
  waterHeaterKw        Float?
  outdoorLightKw       Float?
  meterPhotoUrl        String?
  meterPhotoUploadedAt DateTime?
  rawText              String?
  extractionHistory    String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@unique([year, month])
}

model RentPayment {
  id                   String    @id @default(uuid())
  year                 Int
  month                Int
  paidDate             DateTime?
  rentTaxInvoiceIssued Boolean   @default(false)
  electricityPaid      Boolean   @default(false)
  electricityPaidAt    DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@unique([year, month])
}

model Task {
  id          String   @id @default(uuid())
  title       String
  description String?
  fileUrl     String?
  completed   Boolean  @default(false)
  date        DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AdminMemo {
  id          String                @id @default(uuid())
  title       String
  content     String                @default("")
  category    String                @default("일반")
  color       String                @default("green")
  pinned      Boolean               @default(false)
  archived    Boolean               @default(false)
  username    String?
  password    String?
  siteUrl     String?
  attachments AdminMemoAttachment[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([archived, pinned, updatedAt])
}

model AdminMemoAttachment {
  id          String    @id @default(uuid())
  memoId      String
  fileName    String
  contentType String
  size        Int
  assetUrl    String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  memo        AdminMemo @relation(fields: [memoId], references: [id], onDelete: Cascade)

  @@index([memoId])
}

model MindBoard {
  id        String   @id @default(uuid())
  title     String   @default("New Board")
  items     String   @db.Text
  groups    String   @db.Text
  updatedAt DateTime @updatedAt
}

model AttendanceEmployee {
  id         String             @id @default(uuid())
  name       String
  hourlyWage Int                @default(0)
  dailyHours Float              @default(8)
  active     Boolean            @default(true)
  records    AttendanceRecord[]
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
}

model AttendanceRecord {
  id         String             @id @default(uuid())
  employeeId String
  workDate   DateTime
  employee   AttendanceEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt  DateTime           @default(now())

  @@unique([employeeId, workDate])
  @@index([workDate])
}

model WormEmailAwbCache {
  id        String    @id @default(uuid())
  uid       String    @unique
  subject   String?
  emailDate DateTime?
  awbNumber String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([updatedAt])
}

model WormAwbCustomsMonitor {
  id                    String    @id @default(uuid())
  awbNumber             String    @unique
  emailUid              String?
  orderId               String?
  sourceSubject         String?
  status                String    @default("MONITORING")
  lastStatus            String?
  lastResult            Json?
  checkCount            Int       @default(0)
  lastCheckedAt         DateTime?
  nextCheckAt           DateTime  @default(now())
  completionDetectedAt  DateTime?
  notificationClaimedAt DateTime?
  notifiedAt            DateTime?
  lastError             String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([status, nextCheckAt])
  @@index([emailUid])
  @@index([orderId])
  @@index([notifiedAt])
}

model WormOrder {
  id                               String                  @id @default(uuid())
  orderNumber                      String                  @unique
  receiveDate                      DateTime
  status                           String                  @default("DRAFT")
  createdById                      String?
  remittanceAppliedAt              DateTime?
  remittanceFinalReceiveAmount     Float?
  remittanceFinalReceiveAmountText String?
  remittanceSendAmount             Float?
  remittanceSendAmountText         String?
  remittanceTotalFee               Float?
  remittanceTotalFeeText           String?
  remittanceExchangeRate           Float?
  remittanceExchangeRateText       String?
  emailMatches                     WormOrderEmailMatch[]
  forwardLogs                      WormEmailForwardLog[]
  pipelineSteps                    WormOrderPipelineStep[]
  createdAt                        DateTime                @default(now())
  updatedAt                        DateTime                @updatedAt

  @@index([receiveDate])
  @@index([createdAt])
}

model WormOrderPipelineStep {
  id            String    @id @default(uuid())
  orderId       String
  stepId        Int
  completed     Boolean   @default(false)
  completedAt   DateTime?
  completedById String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  order         WormOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, stepId])
  @@index([orderId, completed])
}

model WormOrderEmailMatch {
  id                    String    @id @default(uuid())
  uid                   String    @unique
  matchType             String    @default("INVOICE")
  subject               String?
  emailDate             DateTime?
  orderId               String
  matchedAt             DateTime  @default(now())
  awbNumber             String?
  emailBodyText         String?
  attachmentsJson       Json?     @default("[]")
  invoiceUnitPriceUsd   Float?
  invoiceTotalAmountUsd Float?
  usdKrwRate            Float?
  invoiceUnitPriceKrw   Float?
  invoiceTotalAmountKrw Float?
  invoiceExtractedAt    DateTime?
  invoiceSourceFile     String?
  invoiceOcrError       String?
  updatedAt             DateTime  @updatedAt
  order                 WormOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([orderId, matchType])
  @@index([updatedAt])
}

model WormEmailForwardLog {
  id              String     @id @default(uuid())
  orderId         String?
  toEmail         String
  fromEmail       String
  subject         String
  attachmentCount Int        @default(0)
  sourceUids      Json?
  sentByUserId    String?
  sentByUserName  String?
  createdAt       DateTime   @default(now())
  order           WormOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@index([createdAt])
  @@index([toEmail])
}

model SmsRecipient {
  id          String   @id @default(uuid())
  name        String
  phoneNumber String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
  @@index([updatedAt])
}

model SmsSendLog {
  id              String   @id @default(uuid())
  refKey          String   @unique
  receiptNum      String?
  fromNumber      String
  toName          String
  toNumber        String
  contents        String
  sendType        String
  scheduled       Boolean  @default(false)
  requestedSendDT String?
  createdAt       DateTime @default(now())

  @@index([createdAt])
  @@index([toName])
  @@index([toNumber])
}

model DepositSms {
  id                String    @id @default(uuid())
  messageHash       String    @unique
  sender            String
  body              String
  receivedAt        DateTime
  amount            Int?
  depositorName     String?
  bankName          String?
  sourceDevice      String?
  matchStatus       String    @default("RECEIVED")
  matchedOrderId    String?
  matchedAt         DateTime?
  candidateOrderIds Json?
  errorMessage      String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  matchedOrder      Order?    @relation(fields: [matchedOrderId], references: [id], onDelete: SetNull)

  @@index([receivedAt])
  @@index([amount])
  @@index([matchStatus])
  @@index([matchedOrderId])
}

model MobileMessage {
  id              String   @id @default(uuid())
  userId          String
  deviceMessageId String
  messageType     String
  direction       String   @default("INBOUND")
  sender          String?
  senderName      String?
  body            String
  receivedAt      DateTime
  threadId        String?
  sourceDevice    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceMessageId])
  @@index([userId, receivedAt])
  @@index([messageType])
  @@index([receivedAt])
}

model MobileOutgoingMessage {
  id            String    @id @default(uuid())
  requestedById String?
  toName        String?
  toNumber      String
  body          String
  status        String    @default("PENDING")
  attemptCount  Int       @default(0)
  sourceDevice  String?
  claimedAt     DateTime?
  sentAt        DateTime?
  failedAt      DateTime?
  lastError     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  requestedBy   User?     @relation(fields: [requestedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([toNumber])
  @@index([requestedById])
}

model NaverSalesDaily {
  id                   String   @id @default(uuid())
  saleDate             DateTime
  channelProductNo     String
  sellerManagementCode String?
  productName          String?
  dbProductId          String?
  dbProductName        String?
  orders               Int      @default(0)
  quantity             Int      @default(0)
  payAmount            Int      @default(0)
  refundAmount         Int      @default(0)
  netAmount            Int      @default(0)
  raw                  Json?
  syncedAt             DateTime @default(now())
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([saleDate, channelProductNo])
  @@index([saleDate])
  @@index([channelProductNo])
  @@index([sellerManagementCode])
  @@index([dbProductId])
}

model NaverSalesInsightDaily {
  id           String   @id @default(uuid())
  saleDate     DateTime
  category     String
  label        String
  detail       String   @default("")
  interactions Int      @default(0)
  inflow       Int      @default(0)
  orders       Int      @default(0)
  quantity     Int      @default(0)
  payAmount    Int      @default(0)
  refundAmount Int      @default(0)
  netAmount    Int      @default(0)
  raw          Json?
  syncedAt     DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([saleDate, category, label, detail])
  @@index([saleDate])
  @@index([category])
}

model NaverSalesRealtimeSnapshot {
  id           String   @id @default(uuid())
  snapshotDate DateTime
  sourceDevice String?
  orders       Int      @default(0)
  quantity     Int      @default(0)
  payAmount    Int      @default(0)
  refundAmount Int      @default(0)
  netAmount    Int      @default(0)
  raw          Json?
  collectedAt  DateTime @default(now())
  createdAt    DateTime @default(now())

  @@index([snapshotDate])
  @@index([createdAt])
}

model NaverSalesSyncLog {
  id                 String    @id @default(uuid())
  sourceDevice       String?
  status             String    @default("SUCCESS")
  requestedStartDate DateTime?
  requestedEndDate   DateTime?
  fetchedAt          DateTime?
  rowsReceived       Int       @default(0)
  rowsUpserted       Int       @default(0)
  errorMessage       String?
  raw                Json?
  createdAt          DateTime  @default(now())

  @@index([createdAt])
  @@index([status])
}

model CoupangSyncHistory {
  id           String   @id @default(uuid())
  createdAt    DateTime @default(now())
  itemsFetched Int      @default(0)
  status       String   @default("SUCCESS")
  errorMessage String?
}

model ProformaInvoice {
  id             String                @id @default(uuid())
  invoiceNumber  String                @unique
  partnerId      String?
  partnerName    String
  issueDate      DateTime              @default(now())
  totalUsd       Float                 @default(0)
  productionTime String                @default("3-5 days after receiving the deposit")
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  partner        User?                 @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  items          ProformaInvoiceItem[]
}

model ProformaInvoiceItem {
  id                String          @id @default(uuid())
  proformaInvoiceId String
  productId         String?
  productName       String
  productNameEN     String?
  productCode       String?
  quantity          Int
  unitPriceUsd      Float
  amountUsd         Float
  createdAt         DateTime        @default(now())
  proformaInvoice   ProformaInvoice @relation(fields: [proformaInvoiceId], references: [id], onDelete: Cascade)
  product           Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
}

model ExportDeclaration {
  id          String                  @id @default(uuid())
  invoiceNo   String
  status      String                  @default("DRAFT")
  form        Json
  totals      Json
  createdById String?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  items       ExportDeclarationItem[]

  @@index([invoiceNo])
  @@index([createdAt])
  @@index([status])
}

model ExportDeclarationItem {
  id                  String            @id @default(uuid())
  exportDeclarationId String
  productId           String?
  lineNo              Int
  productName         String
  productNameEN       String?
  model               String?
  hsCode              String?
  origin              String?
  quantity            Int               @default(0)
  unitPrice           Float             @default(0)
  amount              Float             @default(0)
  cartons             Int               @default(0)
  netWeight           Float             @default(0)
  grossWeight         Float             @default(0)
  cbm                 Float             @default(0)
  dimension           String?
  raw                 Json?
  createdAt           DateTime          @default(now())
  exportDeclaration   ExportDeclaration @relation(fields: [exportDeclarationId], references: [id], onDelete: Cascade)

  @@index([exportDeclarationId])
  @@index([productId])
  @@index([lineNo])
}

model WormEmailAttachmentCache {
  id          String   @id @default(uuid())
  uid         String
  index       Int
  r2Key       String
  r2Url       String
  filename    String?
  contentType String?
  createdAt   DateTime @default(now())

  @@unique([uid, index])
  @@index([uid])
}

model CardUsage {
  id                    String           @id @default(uuid())
  corpNum               String
  cardNum               String
  useKey                String
  useDT                 String
  usedAt                DateTime?
  approvalType          String?
  approvalNum           String?
  approvalAmount        Int?
  foreignApprovalAmount Float?
  amount                Int?
  tax                   Int?
  serviceCharge         Int?
  totalAmount           Int?
  useStoreNum           String?
  useStoreCorpNum       String?
  useStoreTaxType       Int?
  useStoreName          String?
  useStoreCeo           String?
  useStoreAddr          String?
  useStoreBizType       String?
  useStoreTel           String?
  paymentPlan           String?
  installmentMonths     String?
  currencyCode          String?
  memo                  String?
  userMemo              String?
  category              String?
  reviewedAt            DateTime?
  reviewedBy            String?
  coupangPurchaseId     String?
  coupangPurchase       CoupangPurchase? @relation(fields: [coupangPurchaseId], references: [id], onDelete: SetNull)
  raw                   Json?
  syncedAt              DateTime         @default(now())
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@unique([corpNum, cardNum, useKey])
  @@index([usedAt])
  @@index([cardNum])
  @@index([approvalNum])
  @@index([reviewedAt])
  @@index([coupangPurchaseId])
}

model CoupangPurchase {
  id            String      @id @default(uuid())
  orderId       String      @unique
  orderedAt     DateTime
  totalAmount   Int
  paymentMethod String?
  itemSummary   String?
  itemsJson     Json?
  raw           Json?
  syncedAt      DateTime    @default(now())
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  cardUsages    CardUsage[]

  @@index([orderedAt])
  @@index([totalAmount])
}

model SmartThingsConnection {
  id                    String    @id @default("primary")
  accessTokenEncrypted  String
  refreshTokenEncrypted String
  expiresAt             DateTime
  installedAppId        String?
  scope                 String?
  connectedAt           DateTime  @default(now())
  lastSyncAt            DateTime?
  lastError             String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model SmartThingsSensor {
  id              String               @id @default(uuid())
  deviceId        String               @unique
  label           String
  manufacturer    String?
  model           String?
  active          Boolean              @default(true)
  lastTemperature Float?
  lastHumidity    Float?
  lastBattery     Float?
  lastSeenAt      DateTime?
  metadata        Json?
  readings        SmartThingsReading[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([active])
  @@index([lastSeenAt])
}

model SmartThingsReading {
  id              String            @id @default(uuid())
  sensorId        String
  recordedAt      DateTime
  sourceUpdatedAt DateTime?
  temperatureC    Float?
  humidityPercent Float?
  batteryPercent  Float?
  collectedAt     DateTime          @default(now())
  sensor          SmartThingsSensor @relation(fields: [sensorId], references: [id], onDelete: Cascade)

  @@unique([sensorId, recordedAt])
  @@index([recordedAt])
  @@index([sensorId, recordedAt])
}
