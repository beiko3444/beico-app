# MOIN BizPlus automation credentials (server-side only)
MOIN_BIZPLUS_LOGIN_ID=
MOIN_BIZPLUS_LOGIN_PASSWORD=

# Optional: set to "false" to run browser in non-headless mode for debugging
MOIN_BIZPLUS_HEADLESS=true

# Coupang consumer login for purchase-history scraping (optional; can be passed
# per-request via the admin UI instead of being stored here).
COUPANG_USER_LOGIN_ID=
COUPANG_USER_LOGIN_PASSWORD=
# Set to "false" to launch Chromium in non-headless mode (helps clear CAPTCHA).
COUPANG_USER_HEADLESS=true
# Outbound proxy for the Coupang scraper. Required on hosts (Vercel etc.) whose
# IP range is blocked by Coupang's Akamai WAF. The scraper also accepts
# QUOTAGUARDSTATIC_URL / FIXIE_URL / HTTPS_PROXY / HTTP_PROXY (in that order).
# Format: http://user:pass@host:port
COUPANG_USER_PROXY_URL=

# LotteCard direct sync reads from an already logged-in browser session.
# Launch Whale/Chrome with --remote-debugging-port=9222 on the same machine.
LOTTE_CARD_CDP_URL=http://127.0.0.1:9222
LOTTE_CARD_CORP_NUM=
LOTTE_CARD_NUM=

# Android SMS Forwarder -> Raspberry Pi -> Beiko app 입금문자 ingest 인증키
DEPOSIT_SMS_INGEST_SECRET=

# ST Raspberry Pi inventory monitor.
# Use either a fixed monitor URL or a gist raw URL that contains {"url":"https://..."}.
# Beiko's default tunnel gist is built in; these values override it.
SMARTINVENTORY_MONITOR_URL=
SMARTINVENTORY_MONITOR_URL_GIST=
SMARTINVENTORY_MONITOR_TIMEOUT_MS=15000

# Firebase Cloud Messaging for app push notifications.
# Put android/app/google-services.json in place for Android builds.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Optional. Vercel Cron sends Authorization: Bearer $CRON_SECRET when configured.
CRON_SECRET=

# Raspberry Pi -> Beiko app 네이버 판매통계 ingest 인증키
# Vercel/라즈베리 양쪽에 같은 값을 설정합니다.
NAVER_SALES_INGEST_SECRET=

# 라즈베리 네이버 판매통계 수집 스크립트 전용
# Vercel에는 네이버 키를 넣지 않아도 됩니다.
NAVER_COMMERCE_CLIENT_ID=
NAVER_COMMERCE_CLIENT_SECRET=
NAVER_COMMERCE_TOKEN_TYPE=SELF
NAVER_COMMERCE_ACCOUNT_ID=
BEIKO_NAVER_SALES_API_URL=https://www.beiko.co.kr/api/admin/naver-sales/ingest
NAVER_SALES_DAYS=2
NAVER_SALES_SOURCE_DEVICE=raspberry-pi-naver-sales
NAVER_SALES_REQUEST_DELAY_MS=1000
NAVER_SALES_RETRY_COUNT=3
NAVER_SALES_INCLUDE_INSIGHTS=1
NAVER_SALES_INCLUDE_REALTIME=1
